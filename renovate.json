{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "kubernetes": {
    "fileMatch": ["argocd/apps/.+\\.yaml$"]
  },
  "argocd": {
    "fileMatch": ["argocd/apps/.+\\.yaml$"]
  },
  "packageRules": [
    {
      "matchDatasources": ["helm"],
      "groupName": "helm dependencies"
    }
  ]
}